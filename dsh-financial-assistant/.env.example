# 复制为 .env（勿提交）。compose 通过 env_file 注入容器。

# ===== DeepSeek API（settings.yaml 的 apiKeyEnv 指向它）=====
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ===== 载体插件 =====
# 接入方 API Key，逗号分隔；不设置则所有受保护路由 503（fail-closed）。
DSH_API_KEYS=change-me-key-1,change-me-key-2
# 会话默认工作目录（容器内固定 /app/workspace）。
DSH_WORKSPACE=/app/workspace

TZ=Asia/Shanghai
