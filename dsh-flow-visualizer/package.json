{
  "name": "dsh-plugin-flow-tracer",
  "version": "0.1.0",
  "description": "DSH flow visualizer plugin: collect runtime events and stream them to a local viewer",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "viewer/dist",
    "README.md"
  ],
  "scripts": {
    "build:backend": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=lib/index.js",
    "build:viewer": "cd viewer && pnpm build",
    "build": "npm run build:backend && npm run build:viewer",
    "pack": "bash scripts/pack-zip.sh",
    "typecheck": "tsc --noEmit",
    "restart": "bash scripts/restart.sh",
    "start": "bash scripts/restart.sh --no-open",
    "stop": "bash scripts/stop.sh"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.5.0"
  }
}
